{
  "schemaVersion": 1,
  "description": "Authored static response policy. Per-output script hashes are derived after final HTML exists; no nonce or publication approval is generated.",
  "maxCspBytes": 4096,
  "maxRoutes": 2048,
  "csp": {
    "default-src": ["'self'"],
    "script-src": ["'self'"],
    "script-src-attr": ["'none'"],
    "style-src": ["'self'", "'unsafe-inline'"],
    "font-src": ["'self'", "data:"],
    "img-src": ["'self'", "data:", "blob:"],
    "connect-src": ["'self'"],
    "frame-src": ["'self'"],
    "worker-src": ["'self'", "blob:"],
    "base-uri": ["'self'"],
    "form-action": ["'self'"]
  },
  "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" },
  "legacyRedirects": [
    { "src": "^/dashboard(?:/.*|\\.html)?$", "dest": "/", "status": 308 },
    { "src": "^/playground(?:/.*)?$", "dest": "/", "status": 308 }
  ]
}
