{
  "$schemaVersion": "2.0",
  "template": "settings",
  "slots": [
    {
      "id": "skipLabel",
      "type": "text",
      "label": "Skip-to-content link label",
      "maxLength": 40,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "title",
      "type": "text",
      "label": "Page title",
      "maxLength": 24,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "sub",
      "type": "text",
      "label": "Page subtitle",
      "maxLength": 80,
      "runtimeBinding": "text"
    },
    {
      "id": "profileH",
      "type": "text",
      "label": "Profile section heading",
      "maxLength": 24,
      "runtimeBinding": "text"
    },
    {
      "id": "profileP",
      "type": "text",
      "label": "Profile section body",
      "maxLength": 100,
      "runtimeBinding": "text"
    },
    {
      "id": "nameL",
      "type": "text",
      "label": "Name field label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.TextField",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "emailL",
      "type": "text",
      "label": "Email field label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.TextField",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "squadL",
      "type": "text",
      "label": "Squad field label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Select",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "ifaceL",
      "type": "text",
      "label": "Interface language field label",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.NativeSelect",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "squads",
      "type": "list",
      "label": "Squad select options",
      "runtimeBinding": "structured",
      "runtimeProjection": "records",
      "runtimeModel": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "value",
            "label"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "value"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "options",
          "component": "CyberSkillDS.Select"
        }
      ]
    },
    {
      "id": "langs",
      "type": "list",
      "label": "Interface language select options",
      "runtimeBinding": "structured",
      "runtimeProjection": "records",
      "runtimeModel": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "enum": [
                "en",
                "vi"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "value",
            "label"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "value"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "options",
          "component": "CyberSkillDS.NativeSelect"
        }
      ]
    },
