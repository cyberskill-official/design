{
  "$schemaVersion": "2.0",
  "template": "app-shell",
  "slots": [
    {
      "id": "skipLabel",
      "type": "text",
      "label": "Skip-to-content link label",
      "maxLength": 40,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "navLabel",
      "type": "text",
      "label": "Sidebar section label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "nav",
          "attribute": "aria-label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "nav1",
      "type": "text",
      "label": "Nav item 1",
      "maxLength": 24,
      "runtimeBinding": "text"
    },
    {
      "id": "nav2",
      "type": "text",
      "label": "Nav item 2",
      "maxLength": 24,
      "runtimeBinding": "text"
    },
    {
      "id": "nav3",
      "type": "text",
      "label": "Nav item 3",
      "maxLength": 24,
      "runtimeBinding": "text"
    },
    {
      "id": "nav4",
      "type": "text",
      "label": "Nav item 4",
      "maxLength": 24,
      "runtimeBinding": "text"
    },
    {
      "id": "nav5",
      "type": "text",
      "label": "Nav item 5",
      "maxLength": 24,
      "runtimeBinding": "text"
    },
    {
      "id": "searchPh",
      "type": "text",
      "label": "Search placeholder",
      "maxLength": 40,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.SearchField",
          "attribute": "placeholder"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "newBtn",
      "type": "text",
      "label": "Primary button label",
      "maxLength": 24,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "h1",
      "type": "text",
      "label": "Page title",
      "maxLength": 40,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "sub",
      "type": "text",
      "label": "Page subtitle",
      "maxLength": 80,
      "runtimeBinding": "text"
    },
    {
      "id": "s1",
      "type": "text",
      "label": "Stat 1 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s2",
      "type": "text",
      "label": "Stat 2 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s3",
      "type": "text",
      "label": "Stat 3 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s4",
      "type": "text",
      "label": "Stat 4 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s4d",
      "type": "text",
      "label": "Stat 4 delta",
      "maxLength": 20,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "delta"
        }
      ]
    },
    {
      "id": "tblCap",
      "type": "text",
      "label": "Table caption",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.DataTable",
          "attribute": "caption"
        }
      ]
    },
    {
      "id": "cols",
      "type": "table",
      "label": "Project table columns",
      "runtimeBinding": "structured",
      "runtimeProjection": "column-headers",
      "runtimeModel": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "key",
            "header"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "key"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "columns",
          "component": "CyberSkillDS.DataTable"
        }
      ]
    },
    {
      "id": "rows",
      "type": "table",
      "label": "Project table rows",
      "runtimeBinding": "structured",
      "runtimeProjection": "records",
      "runtimeModel": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "squad": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "pct": {
              "type": "number",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "key",
            "name",
            "squad",
            "pct",
            "status"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "key"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "rows",
          "component": "CyberSkillDS.DataTable"
        }
      ]
    }
  ]
}
