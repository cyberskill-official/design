{
  "$schemaVersion": "2.0",
  "template": "bod-report",
  "slots": [
    {
      "id": "headTitle",
      "type": "text",
      "label": "Header title",
      "maxLength": 50,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "conf",
      "type": "text",
      "label": "Confidentiality badge text",
      "maxLength": 30,
      "runtimeBinding": "text"
    },
    {
      "id": "kicker",
      "type": "text",
      "label": "Report eyebrow",
      "maxLength": 40,
      "runtimeBinding": "text"
    },
    {
      "id": "h1",
      "type": "text",
      "label": "Report title",
      "maxLength": 70,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "st1",
      "type": "text",
      "label": "Stat 1 label",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "st2",
      "type": "text",
      "label": "Stat 2 label",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "st3",
      "type": "text",
      "label": "Stat 3 label",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "runway",
      "type": "text",
      "label": "Stat 3 value",
      "maxLength": 20,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "value"
        }
      ]
    },
    {
      "id": "steady",
      "type": "text",
      "label": "Stat 3 delta",
      "maxLength": 20,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "delta"
        }
      ]
    },
    {
      "id": "st4",
      "type": "text",
      "label": "Stat 4 label",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "hlH",
      "type": "text",
      "label": "Highlights section heading",
      "maxLength": 50,
      "runtimeBinding": "text"
    },
    {
      "id": "hlBody",
      "type": "richtext",
      "label": "Highlights body",
      "maxLength": 400,
      "runtimeBinding": "text"
    },
    {
      "id": "aiLabel",
      "type": "text",
      "label": "AI-disclosure label",
      "maxLength": 40,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.AIDisclosureBadge",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "aiDetails",
      "type": "text",
      "label": "AI-disclosure details",
      "maxLength": 200,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.AIDisclosureBadge",
          "attribute": "details"
        }
      ]
    },
    {
      "id": "sources",
      "type": "list",
      "label": "AI-disclosure sources",
      "runtimeBinding": "structured",
      "runtimeProjection": "records",
      "runtimeModel": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "sources",
          "component": "CyberSkillDS.AIDisclosureBadge"
        }
      ]
    },
    {
      "id": "portH",
      "type": "text",
      "label": "Portfolio table heading",
      "maxLength": 50,
      "runtimeBinding": "text"
    },
    {
      "id": "cols",
      "type": "table",
      "label": "Portfolio table columns",
      "runtimeBinding": "structured",
      "runtimeProjection": "column-headers",
      "runtimeModel": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "key",
            "header"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "key"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "columns",
          "component": "CyberSkillDS.DataTable"
        }
      ]
    },
    {
      "id": "rows",
      "type": "table",
      "label": "Portfolio table rows",
      "runtimeBinding": "structured",
      "runtimeProjection": "records",
      "runtimeModel": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "client": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "name",
            "client",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "name"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "rows",
          "component": "CyberSkillDS.DataTable"
        }
      ]
    },
    {
      "id": "riskH",
      "type": "text",
      "label": "Risks section heading",
      "maxLength": 50,
      "runtimeBinding": "text"
    },
    {
      "id": "risk1t",
      "type": "text",
      "label": "Risk 1 title",
      "maxLength": 60,
      "required": true,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Alert",
          "attribute": "title"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "risk1b",
      "type": "richtext",
      "label": "Risk 1 body",
      "maxLength": 240,
      "runtimeBinding": "text"
    },
    {
      "id": "risk2t",
      "type": "text",
      "label": "Risk 2 title",
      "maxLength": 60,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Alert",
          "attribute": "title"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "risk2b",
      "type": "richtext",
      "label": "Risk 2 body",
      "maxLength": 240,
      "runtimeBinding": "text"
    }
  ]
}
