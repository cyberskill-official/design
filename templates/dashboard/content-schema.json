{
  "$schemaVersion": "2.0",
  "template": "dashboard",
  "slots": [
    {
      "id": "skipLabel",
      "type": "text",
      "label": "Skip-to-content link label",
      "maxLength": 40,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "tagline",
      "type": "text",
      "label": "Header tagline",
      "maxLength": 50,
      "runtimeBinding": "text"
    },
    {
      "id": "newBtn",
      "type": "text",
      "label": "Primary button label",
      "maxLength": 24,
      "required": true,
      "runtimeBinding": "text"
    },
    {
      "id": "s1",
      "type": "text",
      "label": "Stat 1 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s2",
      "type": "text",
      "label": "Stat 2 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s3",
      "type": "text",
      "label": "Stat 3 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s4",
      "type": "text",
      "label": "Stat 4 label",
      "maxLength": 24,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "label"
        }
      ],
      "minLength": 1,
      "semanticReason": "Preserve a nonempty accessible name or visible control/section label."
    },
    {
      "id": "s4d",
      "type": "text",
      "label": "Stat 4 delta",
      "maxLength": 20,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.Stat",
          "attribute": "delta"
        }
      ]
    },
    {
      "id": "c1",
      "type": "text",
      "label": "Board card 1 description",
      "maxLength": 80,
      "runtimeBinding": "text"
    },
    {
      "id": "c2",
      "type": "text",
      "label": "Board card 2 description",
      "maxLength": 80,
      "runtimeBinding": "text"
    },
    {
      "id": "c3",
      "type": "text",
      "label": "Board card 3 description",
      "maxLength": 80,
      "runtimeBinding": "text"
    },
    {
      "id": "stInprog",
      "type": "text",
      "label": "Status badge · in progress",
      "maxLength": 24,
      "i18n": {
        "en": "In progress",
        "vi": "Đang làm"
      },
      "runtimeBinding": "text"
    },
    {
      "id": "stBlocked",
      "type": "text",
      "label": "Status badge · blocked",
      "maxLength": 24,
      "i18n": {
        "en": "Blocked",
        "vi": "Bị chặn"
      },
      "runtimeBinding": "text"
    },
    {
      "id": "tblCap",
      "type": "text",
      "label": "Table caption",
      "maxLength": 30,
      "runtimeBinding": "text",
      "runtimeTargets": [
        {
          "tag": "x-import",
          "component": "CyberSkillDS.DataTable",
          "attribute": "caption"
        }
      ]
    },
    {
      "id": "cols",
      "type": "table",
      "label": "Table columns",
      "runtimeBinding": "structured",
      "runtimeProjection": "column-headers",
      "runtimeModel": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "key",
            "header"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "key"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "columns",
          "component": "CyberSkillDS.DataTable"
        }
      ]
    },
    {
      "id": "rows",
      "type": "table",
      "label": "Table rows",
      "runtimeBinding": "structured",
      "runtimeProjection": "records",
      "runtimeModel": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "squad": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "pct": {
              "type": "number",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "key",
            "name",
            "squad",
            "pct",
            "status"
          ],
          "additionalProperties": false
        },
        "uniqueBy": "key"
      },
      "runtimeTargets": [
        {
          "tag": "x-import",
          "attribute": "rows",
          "component": "CyberSkillDS.DataTable"
        }
      ]
    }
  ]
}
