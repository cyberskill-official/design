{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"Generated prompt API inventory references",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","interpretation","sourceHashes","prompts"],
 "properties":{
  "schemaVersion":{"const":1},"interpretation":{"type":"string","minLength":1},
  "sourceHashes":{"type":"object","minProperties":4,"additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
  "prompts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","proseSha256","sectionSha256","exports"],"properties":{
   "path":{"type":"string","pattern":"^components/.+\\.prompt\\.md$"},"proseSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sectionSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
   "exports":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","authoredPropDefinitions","defaultExpressionNames","inheritedPropCount","defaultAnalysis"],"properties":{
    "name":{"type":"string","minLength":1},"authoredPropDefinitions":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^p-[a-f0-9]{16}$"}},"defaultExpressionNames":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"inheritedPropCount":{"type":"integer","minimum":0},"defaultAnalysis":{"type":"string","minLength":1}
   }}}
  }}}
 }
}
