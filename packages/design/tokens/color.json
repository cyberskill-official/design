    "background": {
      "$type": "color",
      "$value": "#F7F8FA",
      "$description": "Page canvas"
    },
    "panel": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Cards and panels"
    },
    "raised": {
      "$type": "color",
      "$value": "#EEF1F5",
      "$description": "Nested sections, hover rows, skeletons"
    },
    "border": {
      "$type": "color",
      "$value": "#DDE2EA",
      "$description": "Dividers and card edges"
    },
    "input": {
      "$type": "color",
      "$value": "#7D889B",
      "$description": "Form control borders (3:1)"
    },
    "foreground": {
      "$type": "color",
      "$value": "#0F1B2D",
      "$description": "Headings and body text"
    },
    "muted": {
      "$type": "color",
      "$value": "#525F73",
      "$description": "Secondary text and labels"
    },
    "primary": {
      "$type": "color",
      "$value": "#14243D",
      "$description": "Ink: main actions, links, structure"
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "accent": {
      "$type": "color",
      "$value": "#F4BA17",
      "$description": "CyberSkill gold: highlights, key actions, AI moments"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "#1A1406"
    },
    "accent-text": {
      "$type": "color",
      "$value": "#8B6902",
      "$description": "Gold used as text. Passes 4.5:1 on background and panel, not on raised"
    },
    "success": {
      "$type": "color",
      "$value": "#067A4B"
    },
    "warning": {
      "$type": "color",
      "$value": "#7B3C00"
