  "chart": {
    "$description": "Categorical series colors in fixed order: blue, gold, teal, magenta, violet. Every pair is >= ΔE 15 apart for normal vision; for color-blind readers neighbours are >= 8 and other pairs >= 6, which needs the legend, direct labels and table view every chart has.",
    "names": [
      "Blue",
      "Gold",
      "Teal",
      "Magenta",
      "Violet"
    ],
    "light": [
      "#2790F8",
      "#C08A06",
      "#03A4A1",
      "#91438C",
      "#B678CF"
    ],
    "dark": [
      "#4C7DB4",
      "#977502",
      "#1C9D77",
      "#A8477A",
      "#AE6FE8"
    ]
  },
  "brand": {
    "ink": {
      "$type": "color",
      "$value": "#14243D",
      "$description": "Fixed brand ink, same in every theme"
    },
    "gold": {
      "$type": "color",
      "$value": "#F4BA17",
      "$description": "Fixed brand gold, same in every theme"
    }
  },
  "category": {
    "$description": "Category tones for icon tiles, avatars and tags, in chart order. Each takes its base color from the chart palette, so a category and its chart series match. Tint and icon only: no text on a solid category color.",
    "names": [
      "blue",
      "amber",
      "teal",
      "magenta",
      "violet"
    ]
  },
  "role": {
    "$description": "How every tone is turned into roles: soft and soft-hover are the share of the tone mixed into the panel, line the share in a tinted border, text and icon the share of the tone kept when mixed toward the foreground. The build fails if text drops under 4.5:1, or an icon under 3:1, on its own tint.",
    "soft": {
      "light": 0.1,
      "dark": 0.16
    },
    "soft-hover": {
      "light": 0.16,
      "dark": 0.24
    },
    "line": {
      "light": 0.3,
      "dark": 0.4
    },
    "text": {
      "status": 0.8,
      "category": 0.6
    },
    "icon": 0.8,
    "wash": 0.06,
    "accent-deep": 0.8
  },
  "inverse": {
    "$description": "The one inverse ink surface on a view (Card surface=\"ink\"): a dark scope painted with a gradient from brand ink to this deeper ink. The build checks dark text, status colors and control edges on both ends.",
    "ink-deep": {
      "$type": "color",
      "$value": "#0E1B33",
      "$description": "End of the ink gradient"
    }
  }
}
