{
  "name": "@cyberskill/design",
  "version": "1.5.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberskill-official/design.git"
  },
  "module": "_esm/react.mjs",
  "types": "_esm/react.d.ts",
  "sideEffects": [
    "**/*.css",
    "./_ds_bundle.js",
    "./_esm/cs.mjs",
    "./image-slot.js",
    "./ui_kits/**/*.js",
    "./ui_kits/**/*.jsx"
  ],
  "exports": {
    ".": {
      "types": "./_esm/react.d.ts",
      "import": "./_esm/react.mjs"
    },
    "./react": {
      "types": "./_esm/react.d.ts",
      "import": "./_esm/react.mjs"
    },
    "./legacy": {
      "import": "./_esm/cs.mjs"
    },
    "./components/*": "./components/*",
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./_ds_bundle.js": "./_ds_bundle.js",
    "./_ds_manifest.json": "./_ds_manifest.json",
    "./styles.min.css": "./dist/styles.min.css"
  },
  "description": "CyberSkill Design System \u2014 HTML-first, Vietnamese-first (EN\u00b7VI). Anchors: Umber #45210E \u00b7 Ochre #F4BA17. Axes: Theme \u00d7 Element \u00d7 Language \u00d7 Style. Bundler React entry (`_esm/react.mjs`) + browser legacy (`_esm/cs.mjs`) + styles.css / _ds_bundle.js. Storybook is host-only playground.",
  "style": "styles.css",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "files": [
    "styles.css",
    "_esm/",
    "tokens/",
    "base/",
    "fonts/",
    "assets/",
    "_ds_bundle.js",
    "_ds_manifest.json",
    "llms.txt",
    "SKILL.md",
    "docs/*.md",
    "docs/vi/",
    "docs/viewer.html",
    "components/",
    "templates/",
    "guidelines/",
    "ui_kits/",
    "_vendor/",
    "DESIGN.md",
    "VERSION",
    "dist/styles.min.css",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "design-system",
    "design-tokens",
    "bilingual",
    "vietnamese",
    "cyberskill"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:react-entry": "node scripts/generate-react-entry.mjs",
    "build:design-md": "node scripts/generate-design-md.mjs",
    "prepublishOnly": "npm run build:bundle && npm run build:react-entry && npm run build:styles && node scripts/generate-design-md.mjs --check && node scripts/flatten-styles.mjs --check && node scripts/generate-contrast-report.mjs --check && npm run version:stamp:check",
    "code-connect:generate": "node _audit/ci/generate-code-connect.mjs",
    "code-connect:dry-run": "node _audit/ci/code-connect-publish.mjs --dry-run",
    "npm:pack-dry-run": "node _audit/ci/npm-publish.mjs --dry-run",
    "native:store-dry-run": "node _audit/ci/native-store-dry-run.mjs --dry-run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build:storybook": "storybook build -o storybook-static && node scripts/stamp-storybook-freshness.mjs",
    "build:site": "npm run build:storybook && node scripts/vercel-static-output.mjs",
    "verify:serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "verify:hint": "echo Open http://127.0.0.1:8765/_audit/run.html and wait for ALL hard gates PASS",
    "verify:local": "bash scripts/verify-local.sh",
    "test:nav-model": "node _audit/ci/test-nav-model.mjs",
    "test:ui-contracts": "node _audit/ci/test-health-tokens-contract.mjs",
    "test:form-paths": "node _audit/ci/test-form-paths.mjs",
    "test:unit": "node _audit/ci/test-nav-model.mjs && node _audit/ci/test-health-tokens-contract.mjs && node _audit/ci/test-docs-consistency.mjs && node _audit/ci/test-base-hex-allowlist.mjs && node _audit/ci/test-form-paths.mjs && node _audit/ci/test-storybook-contract.mjs && node _audit/ci/test-axe-coverage.mjs && node _audit/ci/test-figma-push-helpers.mjs && node _audit/ci/test-native-samples.mjs && node _audit/ci/test-code-connect.mjs && node _audit/ci/test-npm-publish.mjs && node _audit/ci/test-subtree-consume.mjs && node _audit/ci/test-react-entry.mjs && node _audit/ci/test-element-packs.mjs && node _audit/ci/test-i18n-builtins.mjs && node _audit/ci/test-format-currency.mjs && node _audit/ci/check-manifest-coverage.mjs && node _audit/ci/ci-verdict.mjs --selftest && node _audit/ci/test-pack-hygiene.mjs && npm run version:stamp:check && node _audit/ci/test-docs-lang-parity.mjs && node _audit/ci/test-docs-storybook-coverage.mjs && node _audit/ci/test-docs-link-check.mjs && node _audit/ci/test-email-safe.mjs && node _audit/ci/test-prop-parity.mjs && node _audit/ci/test-support-no-eval.mjs && node _audit/ci/test-docx-source-parity.mjs && node _audit/ci/test-doc-export.mjs",
    "test:support-no-eval": "node _audit/ci/test-support-no-eval.mjs",
    "test:docx-source-parity": "node _audit/ci/test-docx-source-parity.mjs",
    "test:audit-probe": "node _audit/ci/audit-probe-suite.mjs",
    "test:element-packs": "node _audit/ci/test-element-packs.mjs",
    "test:react-entry": "node _audit/ci/test-react-entry.mjs",
    "test:subtree-consume": "node _audit/ci/test-subtree-consume.mjs",
    "native:sync-tokens": "node examples/native/sync-tokens.mjs",
    "test:storybook-contract": "node _audit/ci/test-storybook-contract.mjs",
    "test:storybook-coverage": "node _audit/ci/test-storybook-contract.mjs",
    "test:figma-helpers": "node _audit/ci/test-figma-push-helpers.mjs",
    "test:code-connect": "node _audit/ci/test-code-connect.mjs",
    "test:native-samples": "node _audit/ci/test-native-samples.mjs",
    "test:storybook-freshness": "node _audit/ci/test-storybook-freshness.mjs",
    "test:manifest-coverage": "node _audit/ci/check-manifest-coverage.mjs",
    "test:pack-hygiene": "node _audit/ci/test-pack-hygiene.mjs",
    "tokens:elements": "node scripts/generate-element-packs.mjs",
    "tokens:contrast": "node scripts/generate-contrast-report.mjs",
    "build:styles": "node scripts/flatten-styles.mjs",
    "version:check": "node scripts/ds-version.mjs --check",
    "version:selftest": "node scripts/ds-version.mjs --selftest",
    "version:stamp": "node scripts/stamp-release-version.mjs",
    "version:stamp:apply": "node scripts/stamp-release-version.mjs --apply",
    "version:stamp:check": "node scripts/stamp-release-version.mjs --check",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@3.1.0 --output-file bom.cdx.json --output-reproducible --spec-version 1.5",
    "test:docs-lang-parity": "node _audit/ci/test-docs-lang-parity.mjs",
    "test:email-safe": "node _audit/ci/test-email-safe.mjs",
    "test:doc-export": "node _audit/ci/test-doc-export.mjs"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.9",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.4",
    "vite": "^8.1.5"
  }
}
